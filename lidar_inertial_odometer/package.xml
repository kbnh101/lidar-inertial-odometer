<?xml version="1.0"?>
<package format="3">
  <name>lidar_inertial_odometer</name>
  <version>0.1.0</version>
  <description>
    LiDAR-Inertial Odometry (KITTI, ROS 2 Humble).
    point-to-point-plane ICP와 IMU preintegration을 사용한 6-DoF odometry.
    ROS는 rosbag 입출력 인터페이스로만 사용하고 나머지는 모두 자체 class로 구현.
  </description>
  <maintainer email="xnith101@gmail.com">chanho</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>point_to_point_plane_icp</depend>
  <depend>std_msgs</depend>
  <depend>eigen</depend>
  <depend>ceres-solver</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>

  <!-- Eigen 3.4.0 / Ceres 2.1.0 는 시스템 설치본 사용 (GTSAM, PCL 사용 금지) -->

  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>gps_ground_truth</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>rclpy</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
