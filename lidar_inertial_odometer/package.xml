<?xml version="1.0"?>
<package format="2">
  <name>lidar_inertial_odometer</name>
  <version>0.1.0</version>
  <description>
    LiDAR-Inertial Odometry (KITTI, ROS1 Noetic).
    point-to-plane ICP와 IMU preintegration을 사용한 6-DoF odometry.
    ROS는 rosbag 입출력 인터페이스로만 사용하고 나머지는 모두 자체 class로 구현.
  </description>
  <maintainer email="xnith101@gmail.com">chanho</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <!-- Eigen 3.4.0 / Ceres 2.1.0 는 시스템 설치본 사용 (GTSAM, PCL 사용 금지) -->

  <exec_depend>rosbag</exec_depend>
  <exec_depend>rviz</exec_depend>

  <export>
  </export>
</package>
